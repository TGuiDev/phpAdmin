<p class="mb-2 text-sm">
    <a href="/connections/<?= e($profile->id) ?>/databases/<?= rawurlencode($database) ?>/tables" class="text-primary hover:underline">&larr; Voltar para tabelas</a>
</p>

<p class="mb-4 text-sm text-muted-foreground">Instrucoes digitadas aqui sao executadas diretamente no banco conectado, sem restricoes adicionais. Use com cuidado.</p>

<form method="post" action="/connections/<?= e($profile->id) ?>/databases/<?= rawurlencode($database) ?>/query" id="sql-form">
    <?= \App\Support\Csrf::field() ?>
    <textarea
        name="sql"
        id="sql-textarea"
        rows="10"
        placeholder="SELECT * FROM ..."
        class="mb-3 w-full rounded-md border border-input bg-transparent p-3 font-mono text-sm text-foreground focus:outline-none focus:ring-1 focus:ring-primary"
    ><?= e($sql) ?></textarea>
    <div id="sql-editor" class="mb-3 hidden overflow-hidden rounded-md border border-input"></div>
