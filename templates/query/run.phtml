<?php if ($error !== null): ?>
    <div class="mt-4 rounded-md border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm text-destructive"><?= e($error) ?></div>
<?php endif; ?>

<?php if ($result !== null): ?>
    <?php if ($result['is_select']): ?>
        <p class="mt-4 mb-2 text-sm text-muted-foreground"><?= count($result['rows']) ?> linha(s) retornada(s).</p>
        <?php if ($result['rows'] !== []): ?>
            <div class="overflow-x-auto rounded-lg border border-border bg-card shadow-sm">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-border text-left text-muted-foreground">
                            <?php foreach ($result['columns'] as $col): ?>
                                <th class="whitespace-nowrap px-4 py-2 font-medium"><?= e($col) ?></th>
                            <?php endforeach; ?>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($result['rows'] as $row): ?>
                            <tr class="border-b border-border last:border-0 hover:bg-muted/50">
                                <?php foreach ($result['columns'] as $col): ?>
                                    <td class="whitespace-nowrap px-4 py-2"><?= format_cell($row[$col] ?? null) ?></td>
                                <?php endforeach; ?>
                            </tr>
                        <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
        <?php endif; ?>
    <?php else: ?>
        <div class="mt-4 rounded-md border border-success/40 bg-success/10 px-3 py-2 text-sm text-success"><?= $result['affected'] ?> linha(s) afetada(s).</div>
    <?php endif; ?>
<?php endif; ?>

<script type="importmap">
{
    "imports": {
        "codemirror": "https://esm.sh/codemirror@6",
        "@codemirror/lang-sql": "https://esm.sh/@codemirror/lang-sql@6",
        "@codemirror/state": "https://esm.sh/@codemirror/state@6",
        "@codemirror/view": "https://esm.sh/@codemirror/view@6"
    }
}
</script>
<script type="module">
    import { EditorView, basicSetup } from 'codemirror';
    import { sql } from '@codemirror/lang-sql';

    try {
        const schema = <?= json_encode($schema ?? [], JSON_THROW_ON_ERROR) ?>;
        const textarea = document.getElementById('sql-textarea');
        const container = document.getElementById('sql-editor');

        const view = new EditorView({
            doc: textarea.value,
            extensions: [
                basicSetup,
                sql({ schema }),
                EditorView.theme({
                    '&': { fontSize: '0.85rem', backgroundColor: 'transparent' },
                    '.cm-content': { fontFamily: 'Consolas, Menlo, monospace', minHeight: '10rem' },
                    '.cm-gutters': { backgroundColor: 'transparent', border: 'none' },
                }, { dark: true }),
            ],
            parent: container,
        });

        textarea.classList.add('hidden');
        container.classList.remove('hidden');

        document.getElementById('sql-form').addEventListener('submit', () => {
            textarea.value = view.state.doc.toString();
        });
    } catch (err) {
        console.error('Nao foi possivel carregar o editor CodeMirror, usando textarea simples.', err);
    }
</script>
